############
# Supabase self-hosted (copy to docker/.env)
############
POSTGRES_PASSWORD=your-super-secret-postgres-password
# Regenerate keys after changing JWT_SECRET: node scripts/generate-jwt-keys.mjs "$JWT_SECRET"
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5NTU4MjQxLCJleHAiOjE5MzcyMzgyNDF9.eQlWtme6LS0_ES6V6WJV-_ov3aaYxw4QG6G2gzOeNgM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3Nzk1NTgyNDEsImV4cCI6MTkzNzIzODI0MX0.nbV8hYj-O4_a3onyBFzvNo5El5hih0Y2NDF0mlZrj5o

SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# Chat LLM (remote vLLM via ngrok - NOT LM Studio)
# Used by: rag-assistant, generate-summary, extract-metadata, auto-assign-tags.
# Context window is 32k; the endpoint returns 400 past that.
############
CHAT_BASE_URL=http://vllm-chat:8000/v1
CHAT_MODEL=Qwen/Qwen3.5-35B-A3B
# vLLM here accepts any bearer token; kept for symmetry with LMSTUDIO_API_KEY.
CHAT_API_KEY=not-needed

############
# LM Studio (edge functions reach host via host.docker.internal)
# Serves embeddings + OCR (Chandra) + translation + Whisper.
# Any role can be repointed with <ROLE>_BASE_URL: TRANSLATE_, EMBED_, OCR_, WHISPER_.
############
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Fallback chat model for every LM Studio-bound role (used when a role has no
# explicit model set). Must be an exact model ID LM Studio exposes — check http://localhost:1234/v1/models
# Examples below match the EVIGSENSE reference stack (Qwen3 chat + Qwen3 embeddings + Chandra OCR VLM)
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
# Optional dedicated translator (falls back to LMSTUDIO_CHAT_MODEL). Use a smaller/faster model for RU→EN.
LMSTUDIO_TRANSLATE_MODEL=google/gemma-4-e4b
TRANSLATE_BASE_URL=http://vllm-chat:8000/v1
TRANSLATE_MODEL=Qwen/Qwen3.5-35B-A3B
LMSTUDIO_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
# Must equal the embed model's output dim. bge-m3 and Qwen3-Embedding-0.6B are both 1024.
EMBEDDING_DIM=1024

############
# Embeddings + reranking (Qwen3-VL on vLLM)
#
# Qwen3-VL-Embedding-2B is natively 2048-dim and supports Matryoshka output from
# 64 to 2048; EMBED_DIMENSIONS=1024 keeps it matching the vector(1024) column, so
# EMBEDDING_DIM must stay in sync with it. Leave EMBED_DIMENSIONS empty when
# serving from LM Studio -- llama.cpp rejects the unknown `dimensions` field.
#
# llama.cpp support for this model is still an unmerged draft, so vLLM (>=0.14.0)
# with a pooling runner is the supported way to serve it.
############
# Service names resolve because docker-compose.vllm.yml joins this project.
# Off-box instead? Use http://<host>:8103/v1 (or host.docker.internal:8103).
EMBED_BASE_URL=http://vllm-embed:8000/v1
EMBED_API_KEY=
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# Empty: this vLLM deployment's pooler_config has no Matryoshka dims
# configured, so it 400s on the `dimensions` request param ("Model does
# not support Matryoshka embeddings"). embed() truncates 2048 -> 1024
# client-side instead (L2-renormalized, same MRL maths).
EMBED_DIMENSIONS=

# Cross-encoder rerank of the vector-search candidates. Optional: leave
# RERANK_MODEL empty and the pipeline skips reranking entirely.
RERANK_BASE_URL=http://vllm-rerank:8000/v1
RERANK_API_KEY=
# Non-empty turns the rerank stage ON. The app POSTs to <RERANK_BASE_URL>/rerank.
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
# Candidates pulled from pgvector, then narrowed by the reranker.
RERANK_CANDIDATES=50
RERANK_TOP_K=8

############
# OCR (Chandra)
############
# "lmstudio" means "a VLM over /v1/chat/completions" - it works against any
# OpenAI-compatible server, vLLM included. Use "chandra-native" only for
# Chandra's own non-OpenAI /ocr server on CHANDRA_BASE_URL.
OCR_BACKEND=chandra-native
OCR_BASE_URL=http://vllm-ocr:8000/v1
OCR_MODEL=chandra-ocr-2
# Reasoning OCR models (chandra-ocr-2, etc.) need a big token budget for
# chain-of-thought + final markdown. 16k handles dense single pages.
OCR_MAX_TOKENS=16384
# Optional reasoning effort hint forwarded to LM Studio: "low" | "medium" | "high".
OCR_REASONING_EFFORT=low
CHANDRA_BASE_URL=http://chandra-relay:8001

############
# Audio transcription
############
AUDIO_BACKEND=disabled
WHISPER_BASE_URL=http://host.docker.internal:1234/v1
WHISPER_MODEL=whisper-1

############
# Default user seeding (scripts/seed-users.mjs, run via `npm run seed:users`)
# Creates one account per app_role on a fresh stack so you never hand-create
# users in Studio: admin@jyoma.ai / moderator@jyoma.ai / user@jyoma.ai
############
SEED_DEFAULT_USERS=true
# Shared password for the seeded accounts. CHANGE THIS before exposing the stack.
SEED_DEFAULT_PASSWORD=ChangeMe!2026
# Optional override of the account list: email:role,email:role (roles: admin|moderator|user)
# SEED_USERS=admin@jyoma.ai:admin,moderator@jyoma.ai:moderator,user@jyoma.ai:user

############
# vLLM model servers on DGX Spark (docker-compose.models.yml)
#
# ONE ~119.7 GiB unified pool is shared by the OS, page cache, weights and KV
# cache. Each *_MEM below is a fraction of that whole pool and they ADD UP:
# 0.45 + 0.15 + 0.08 + 0.08 = 0.76, leaving ~28 GiB headroom. Raising one means
# lowering another.
#
# Needs an arm64 / sm_121a image. NGC is the supported one; the community
# GB10 builds track vLLM main more closely if you need a newer feature.
############
# --- Pointing the app at these servers -------------------------------------
# Everything on the Spark (compose files combined) -- reach them by service name:
#   CHAT_BASE_URL=http://vllm-chat:8000/v1
#   OCR_BASE_URL=http://vllm-ocr:8000/v1
#   EMBED_BASE_URL=http://vllm-embed:8000/v1
#   RERANK_BASE_URL=http://vllm-rerank:8000/v1
# Spark remote, app elsewhere -- use its address and the published ports:
#   CHAT_BASE_URL=http://<spark-host>:8101/v1
#   OCR_BASE_URL=http://<spark-host>:8102/v1
#   EMBED_BASE_URL=http://<spark-host>:8103/v1
#   RERANK_BASE_URL=http://<spark-host>:8104/v1
# Reranking stays off until RERANK_MODEL is non-empty, regardless of the URL.
# ---------------------------------------------------------------------------
# --- x86_64 + CUDA host (docker-compose.vllm.yml) --------------------------
VLLM_IMAGE_CUDA=vllm/vllm-openai:latest
# Both 2B models at bf16 need ~9-10GB and will NOT both fit on an 8GB card.
# Set fp8 (Ada sm_89 / Blackwell) to halve the weights, or run only vllm-embed.
# fp8 halves each 2B model's bf16 weight footprint (~4.5GB -> ~2.3GB) so both
# embed and rerank can be resident together on an 8GB card. Measured on this
# machine: LM Studio's chat+OCR footprint is small (~1GB) despite the 6.33GB /
# 3.60GB figures `lms ps` reports for the model files -- gpu_memory_utilization
# below is sized against real free VRAM, not against those file sizes.
VLLM_QUANTIZATION=fp8
# Fractions of DEDICATED VRAM (not the Spark's unified pool - different scale).
# vLLM's budget = fraction * TOTAL device memory, and weights alone must fit
# inside it -- 0.45 (3.6GB) undersized even a single fp16 2B model with nothing
# left for KV cache. fp8 weights are ~2.3GB, so 0.35-0.4 leaves headroom.
# On a 24GB+ card these can go back to bf16 (VLLM_QUANTIZATION=) at ~0.45 each.
VLLM_CUDA_EMBED_MEM=0.70
VLLM_CUDA_RERANK_MEM=0.28
VLLM_CUDA_EMBED_CTX=6144
VLLM_CUDA_RERANK_CTX=2048
# --- DGX Spark, arm64 / sm_121a (docker-compose.models.yml) -----------------
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3
# Only needed for gated HF repos.
HF_TOKEN=

# Model ids pulled from HuggingFace. The *_MODEL vars above are the names the
# app sends; these are what vLLM actually loads.
CHAT_MODEL_ID=Qwen/Qwen3.5-35B-A3B
OCR_MODEL_ID=datalab-to/chandra-ocr-2
EMBED_MODEL_ID=Qwen/Qwen3-VL-Embedding-2B
RERANK_MODEL_ID=Qwen/Qwen3-VL-Reranker-2B

VLLM_CHAT_PORT=8101
VLLM_OCR_PORT=8102
VLLM_EMBED_PORT=8103
VLLM_RERANK_PORT=8104

VLLM_CHAT_MEM=0.64
VLLM_OCR_MEM=0.10
VLLM_EMBED_MEM=0.08
VLLM_RERANK_MEM=0.06

VLLM_CHAT_CTX=32768
VLLM_OCR_CTX=24576
VLLM_EMBED_CTX=8192
VLLM_RERANK_CTX=4096

# Spark trades memory bandwidth for capacity; low concurrency serves better.
VLLM_CHAT_SEQS=4
VLLM_OCR_SEQS=2

############
# Internal function auth
############
INTERNAL_FUNCTION_SECRET=change-me-to-a-random-secret

############
# Collabora Online (offline .docx editor)
############
# Browser-facing editor URL (the iframe loads from here).
COLLABORA_PUBLIC_URL=http://localhost:9980
# Container-to-container URL used by edge functions for convert-to.
COLLABORA_INTERNAL_URL=http://collabora:9980
# Must equal the app's browser origin (net.frame_ancestors + PostMessageOrigin).
COLLABORA_FRAME_ANCESTORS=http://localhost:8080
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=admin
