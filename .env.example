# Frontend (Vite)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5NTU4MjQxLCJleHAiOjE5MzcyMzgyNDF9.eQlWtme6LS0_ES6V6WJV-_ov3aaYxw4QG6G2gzOeNgM
VITE_SUPABASE_PROJECT_ID=local
# Page-level translate-markdown fan-out. Default 2. Bump to 4 only if LM Studio
# has parallel generation enabled (Settings → Server → Parallel Generation).
VITE_TRANSLATION_CONCURRENCY=2
# Collabora editor, loaded by the BROWSER.
VITE_COLLABORA_URL=http://localhost:9980
# WOPI callback base, resolved by the COLLABORA CONTAINER (not the browser).
# Must be a container-reachable address, hence kong: not localhost:.
VITE_WOPI_HOST_BASE=http://kong:8000

# Self-hosted Supabase (docker/.env)
POSTGRES_PASSWORD=your-super-secret-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5NTU4MjQxLCJleHAiOjE5MzcyMzgyNDF9.eQlWtme6LS0_ES6V6WJV-_ov3aaYxw4QG6G2gzOeNgM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3Nzk1NTgyNDEsImV4cCI6MTkzNzIzODI0MX0.nbV8hYj-O4_a3onyBFzvNo5El5hih0Y2NDF0mlZrj5o
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# Chat LLM (remote vLLM via ngrok — NOT LM Studio).
# Used by rag-assistant, generate-summary, extract-metadata, auto-assign-tags.
# 32k context window; the endpoint returns 400 past that.
CHAT_BASE_URL=https://evigsense.ngrok.dev/v1
CHAT_MODEL=Qwen/Qwen3.5-35B-A3B
CHAT_API_KEY=not-needed

# LM Studio (edge functions) — embeddings + OCR + translation + Whisper.
# Any role can be repointed with <ROLE>_BASE_URL: TRANSLATE_, EMBED_, OCR_, WHISPER_.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Fallback model for LM Studio-bound roles with no explicit model set.
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
# Dedicated translator (falls back to LMSTUDIO_CHAT_MODEL).
LMSTUDIO_TRANSLATE_MODEL=google/gemma-4-e4b
LMSTUDIO_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b

# Embeddings: Qwen3-VL-Embedding-2B on vLLM (>=0.14.0), MRL-truncated to 1024.
# EMBED_DIMENSIONS and EMBEDDING_DIM must agree with the vector(N) column.
# Leave EMBED_DIMENSIONS empty if serving from LM Studio — it rejects the field.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBED_DIMENSIONS=1024
EMBEDDING_DIM=1024

# Cross-encoder rerank. Empty RERANK_MODEL disables the stage entirely.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CANDIDATES=50
RERANK_TOP_K=8

# OCR (Chandra)
OCR_BACKEND=lmstudio
OCR_MODEL=chandra-ocr-2
# Reasoning OCR models need a big token budget for CoT + final markdown.
OCR_MAX_TOKENS=16384
# "low" | "medium" | "high"
OCR_REASONING_EFFORT=low
CHANDRA_BASE_URL=http://host.docker.internal:8001

# Audio
AUDIO_BACKEND=disabled
WHISPER_BASE_URL=http://host.docker.internal:1234/v1
WHISPER_MODEL=whisper-1

# Default user seeding (npm run seed:users) — one account per app_role:
# admin@jyoma.ai / moderator@jyoma.ai / user@jyoma.ai
SEED_DEFAULT_USERS=true
# CHANGE THIS before exposing the stack.
SEED_DEFAULT_PASSWORD=ChangeMe!2026
# Optional override: email:role,email:role (roles: admin|moderator|user)
# SEED_USERS=admin@jyoma.ai:admin,moderator@jyoma.ai:moderator,user@jyoma.ai:user

# Internal function auth
INTERNAL_FUNCTION_SECRET=change-me-to-a-random-secret

# Collabora Online (offline .docx editor)
COLLABORA_PUBLIC_URL=http://localhost:9980
COLLABORA_INTERNAL_URL=http://collabora:9980
COLLABORA_FRAME_ANCESTORS=http://localhost:8080
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=admin
